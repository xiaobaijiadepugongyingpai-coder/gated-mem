{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "eval_cases.schema.json",
  "title": "Gated-Mem 阶段一 40 组演进测试集（CONTRACT.md §3 数据契约）",
  "description": "描述性 Schema，供人工阅读与编辑器提示；真正的约束判定以 benchmarks/tools/validate_dataset.py 为准。",
  "type": "object",
  "required": [
    "dataset_version",
    "case_count",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "case_count": {
      "type": "integer",
      "const": 40,
      "description": "必须等于 cases 数组长度（§3.5 约束 1）"
    },
    "cases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "memoryType": {
      "type": "string",
      "enum": [
        "DECISION",
        "CONSTRAINT",
        "PREFERENCE",
        "EPHEMERAL"
      ],
      "description": "§1.1 类型参数表"
    },
    "probeType": {
      "type": "string",
      "enum": [
        "current_state",
        "anti_trap",
        "evolution_why"
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "content",
        "subject",
        "predicate",
        "scope",
        "memory_type",
        "input_weight"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+$",
          "description": "case 内唯一，如 M1..M8"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "global 或 branch:xxx（§2.1 槽位三元组第三维）"
        },
        "memory_type": {
          "$ref": "#/definitions/memoryType"
        },
        "input_weight": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "description": "元素必须是本 case 中更早出现的 event id；禁止前向引用/自引用/环（§3.5 约束 9）"
        },
        "residual_diff": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^\\[Replaced"
          },
          "description": "纯自然语言原因；发生槽位覆盖的事件必须携带，且须含被覆盖旧节点 content 中的技术关键词（§3.5 约束 9）"
        }
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "probe_type",
        "query",
        "must_include",
        "must_exclude"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_type": {
          "$ref": "#/definitions/probeType"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "must_include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "must_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect_survive": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "description": "仅 anti_trap 使用：必须出现在 injected_node_ids 中的节点 id"
        },
        "old_keyword": {
          "type": "string",
          "minLength": 1,
          "description": "仅 evolution_why 使用：必须出现在某条 residual_diff 中（§3.5 约束 9）"
        },
        "expect_nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "description": "建议填：current_state 期望被注入的节点 id（供人工复核，不参与判定）"
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "scenario_id",
        "domain",
        "description",
        "is_control",
        "construction_note",
        "tags",
        "session_events",
        "probes"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^S(0[1-9]|[1-3][0-9]|40)$",
          "description": "S01..S40 连续唯一零填充（§3.5 约束 1）"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "description": "数据集内去重 ≥ 6 种（§3.5 约束 4）"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "is_control": {
          "type": "boolean",
          "description": "负控制组 ≥ 8 组（§3.5 约束 8）"
        },
        "construction_note": {
          "type": "string",
          "minLength": 1,
          "description": "is_control=true 时必须说明控制目的（≥10 字）"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "evolution",
              "multi_parent",
              "scope_isolation",
              "fake_conflict",
              "control"
            ]
          }
        },
        "session_events": {
          "type": "array",
          "minItems": 6,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/event"
          }
        },
        "probes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/probe"
          }
        }
      }
    }
  }
}
